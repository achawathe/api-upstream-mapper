    "id": "persistent_identity_vs_request_echo",
    "expected": "ledgerKey",
    "reason": "Target needs bank account identity. Source accountId is explicitly documented as a caller correlation token.",
    "target": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "description": "Persistent unique identifier of the bank account."
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "description": "Caller-provided correlation token echoed in this response for tracing the request, not the bank account identifier."
        },
        "ledgerKey": {
          "type": "string",
          "description": "Persistent unique identifier assigned to the bank account and unchanged across requests."
        }
      }
    },
    "up_samples": [
      {
        "accountId": "ACC-A"
      },
      {
        "accountId": "ACC-A"
      }
    ],
    "down_samples": [
      {
        "accountId": "REQ-X",
        "ledgerKey": "ACC-A"
      },
      {
        "accountId": "REQ-Y",
        "ledgerKey": "ACC-A"
      }
    ]
  },
